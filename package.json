{
  "name": "bogen-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": ["packages/core", "packages/server", "apps/editor"],
  "scripts": {
    "dev": "npm run dev --workspace @bogen/editor",
    "build": "npm run build --workspace @bogen/editor && npm run build --workspace bogen-design",
    "start": "node packages/server/dist/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p apps/editor",
    "release": "node scripts/release.mjs",
    "release:npm": "node scripts/release-npm.mjs",
    "release:keygen": "node scripts/release-keygen.mjs",
    "release:notes": "node scripts/changelog-notes.mjs",
    "version:set": "node scripts/set-version.mjs",
    "check:release-source": "node scripts/check-release-source.mjs",
    "check:docs": "tsx scripts/gen-docs-reference.ts --check && node scripts/check-doc-links.mjs && node scripts/gen-third-party-notices.mjs --check",
    "check:exact": "node --import tsx scripts/check-exact-export.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vue/compiler-sfc": "^3.5.45",
    "svelte": "^5.57.3",
    "typescript": "^5.9",
    "vitest": "^5"
  },
  "engines": { "node": ">=22.18" }
}
