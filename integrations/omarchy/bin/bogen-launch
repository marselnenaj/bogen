#!/bin/bash
# Managed by Bogen integrations/omarchy.
# Opens the Bogen window, starting the server first if it is down.
# With a path, opens that .bogen file: bogen-launch ~/Designs/landing.bogen
# With --file <id>, shows that file: in the Bogen window that has it, if there is one.
set -u

URL=${BOGEN_URL:-http://127.0.0.1:29990}
PATTERN='127\.0\.0\.1__'

up() { curl -fsS -m 1 -o /dev/null "$URL/api/status" 2>/dev/null; }
tell() { omarchy-notification-send --app-name=Bogen -i bogen -u normal "$@"; }

if ! up; then
  systemctl --user start bogen.service 2>/dev/null
  for _ in {1..40}; do
    up && break
    sleep 0.25
  done
fi
if ! up; then
  tell "Bogen server did not start" "See: journalctl --user -u bogen"
  exit 1
fi

# One window per file: a Bogen window that shows the file, or one in view, takes it (the server's /api/open), and
# Hyprland raises it by its title when the browser could not. Only otherwise does a new window open.
show() {
  local hash=$1 answer title addr clients
  answer=$(curl -fsS -m 5 -X POST -H 'Content-Type: application/json' \
    --data "$(jq -cn --arg h "$hash" '{hash: $h, raise: true}')" "$URL/api/open" 2>/dev/null) || answer='{}'
  if [[ $(jq -r '.taken == true' <<<"$answer" 2>/dev/null) == true ]]; then
    [[ $(jq -r '.focused == true' <<<"$answer") == true ]] && exit 0
    title=$(jq -r '.title // ""' <<<"$answer")
    clients=$(hyprctl -j clients 2>/dev/null) || clients='[]'
    addr=$(jq -r --arg t "$title" '
      [.[] | select($t != "" and (.title == $t or (.title | startswith($t + " - "))))] as $named
      | [.[] | select(.class | test("127\\.0\\.0\\.1__"))] as $bogen
      | if ($named | length) == 1 then $named[0].address
        elif ($named | length) == 0 and ($bogen | length) == 1 then $bogen[0].address
        else empty end' <<<"$clients" 2>/dev/null)
    if [[ -n $addr ]] && hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1; then
      exit 0
    fi
  fi
  exec omarchy-launch-webapp "$URL/$hash"
}

if [[ ${1:-} == --file ]]; then
  id=${2:-}
  [[ $id =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { tell "Bogen" "No such file: ${id:0:64}"; exit 1; }
  show "#/file/$id"
fi

if [[ -n ${1:-} ]]; then
  id=$(curl -fsS -m 30 -X POST -H 'Content-Type: application/octet-stream' \
    -H "X-Bogen-Filename: $(basename -- "$1")" --data-binary "@$1" \
    "$URL/api/files/import" 2>/dev/null | jq -r '.id // empty')
  if [[ -n $id ]]; then
    show "#/file/$id"
  fi
  tell "Could not open $(basename -- "$1")" "This Bogen server cannot import that file."
fi

exec omarchy-launch-or-focus-webapp "$PATTERN" "$URL"
