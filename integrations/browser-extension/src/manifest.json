{
 "manifest_version": 3,
 "name": "Bogen capture",
 "short_name": "Bogen",
 "version": "0.0.0",
 "description": "Send the current tab, a region or an element to Bogen on this computer as editable layers.",
 "permissions": ["activeTab", "scripting", "storage"],
 "action": {
  "default_title": "Capture to Bogen",
  "default_popup": "popup.html",
  "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
 },
 "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
 "commands": {
  "_execute_action": { "suggested_key": { "default": "Alt+Shift+B" }, "description": "Open Bogen capture" }
 },
 "background": { "service_worker": "background.js" },
 "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* http://localhost:*" }
}
